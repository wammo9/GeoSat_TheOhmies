{
  "name": "geosat-team-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
